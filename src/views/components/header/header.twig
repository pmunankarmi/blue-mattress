{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

<header class="site-header" id="siteHeader">
        <nav class="nav-row" aria-label="${t('navMain')}">
          <a class="brand" href="{{ store.url }}" aria-label="{{ store.name }}">
            <img class="brand-logo brand-logo--color" src="{{ store.logo|cdn(175) }}" width="438" height="250" alt="{{ store.name }}">
            <img class="brand-logo brand-logo--white" src="{{ store.logo|cdn(175) }}" width="383" height="200" alt="{{ store.name }}" aria-hidden="true">
          </a>
          <custom-main-menu></custom-main-menu>
          <div class="nav-actions">
            <button class="icon-btn" type="button" id="searchBtn" title="${t('search')}" aria-label="${t('search')}">${ICON.search}</button>
            <button class="icon-btn theme-toggle" type="button" id="themeBtn" title="${BLUE.AR() ? 'الوضع الليلي / النهاري' : 'Toggle dark mode'}" aria-label="${BLUE.AR() ? 'تبديل الوضع الليلي' : 'Toggle dark mode'}"><span class="th-moon">${ICON.moon}</span><span class="th-sun">${ICON.sun}</span></button>
            <a class="nav-link lang-switch" href="${twinUrl()}" title="${t('langTitle')}" lang="${BLUE.AR() ? 'en' : 'ar'}">${t('langSwitch')}</a>
            <button class="icon-btn" type="button" id="cartBtn" title="${t('openCart')}" aria-label="${t('openCart')}">${ICON.cart}<span class="cart-count" id="cartCount"></span></button>
            <button class="icon-btn nav-burger" type="button" id="burgerBtn" aria-label="${t('menu')}">${ICON.burger}</button>
          </div>
        </nav>
      </header>
      <div class="mobile-menu" id="mobileMenu">
        <button class="icon-btn mm-close" id="mmClose" aria-label="${t('close')}">${ICON.close}</button>
        <a href="${href('shop.html')}">${t('navStore')}</a>
        <a href="${href('shop.html')}?cat=mattresses">${t('navMattresses')}</a>
        <a href="${href('selector.html')}">${t('navFinder')}</a>
        <a href="${href('index.html')}#story">${t('navStory')}</a>
        <a href="${href('contact.html')}">${t('navContact')}</a>
        <a class="lang-switch" href="${twinUrl()}" lang="${BLUE.AR() ? 'en' : 'ar'}">${t('langSwitch')}</a>
      </div>



</header>
